<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project coordinates: how Maven uniquely identifies this project -->
    <groupId>com.qa.data</groupId>
    <artifactId>test-data-manager</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>TestDataManager</name>
    <description>A Test Data Management utility that reads test data from Excel and configuration from JSON.</description>

    <!-- Project-wide settings -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>com.qa.data.TestDataManager</exec.mainClass>
    </properties>

    <!-- External libraries this project depends on. Maven downloads these automatically. -->
    <dependencies>

        <!-- Apache POI: reads/writes Microsoft Excel (.xlsx) files -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- Jackson Databind 3.x: converts JSON files to/from Java objects.
             Jackson 3 uses the NEW group id "tools.jackson.core" (2.x used
             "com.fasterxml.jackson.core") and the new Java package "tools.jackson.*".
             Jackson 3 requires Java 17+ (we run Java 21). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.2.3</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Lets us run the program with: mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
